---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Feel good in your body with thoughtful nutrition and a little more balance.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Goodkind Nutrition</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label="Goodkind Nutrition home">
				<span class="brand-mark" aria-hidden="true">g.</span>
				<span>goodkind<span class="brand-sub">NUTRITION, WITH HEART</span></span>
			</a>
			<nav class="main-nav" aria-label="Main navigation">
				<a href="/#approach">My approach</a>
				<a href="/shop">The shop</a>
				<a href="/#about">About</a>
			</nav>
			<div class="header-actions">
				<a class="header-login" href="/login">Log in</a>
				<a class="button button-small" href="/register">Work with me <span aria-hidden="true">↗</span></a>
				<a class="cart-link" href="/shop" aria-label="Shopping bag, 0 items">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z" stroke="currentColor" stroke-width="1.5"/><path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
					<span class="cart-count" aria-live="polite">0</span>
				</a>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<a class="brand footer-brand" href="/">
				<span class="brand-mark" aria-hidden="true">g.</span>
				<span>goodkind<span class="brand-sub">NUTRITION, WITH HEART</span></span>
			</a>
			<p>Good food. A kinder relationship with your body.</p>
			<div class="footer-links"><a href="/shop">Shop</a><a href="/login">Log in</a><a href="/register">Get in touch</a></div>
			<span class="copyright">© 2026 Goodkind Nutrition</span>
		</footer>
		<script>
			const updateCartCount = () => {
				const count = Number(localStorage.getItem('goodkind-cart-count') || 0);
				document.querySelectorAll('.cart-count').forEach((element) => {
					element.textContent = String(count);
				});
				document.querySelectorAll('.cart-link').forEach((element) => {
					element.setAttribute('aria-label', `Shopping bag, ${count} ${count === 1 ? 'item' : 'items'}`);
				});
			};
			updateCartCount();
			window.addEventListener('storage', updateCartCount);
			window.addEventListener('goodkind-cart-updated', updateCartCount);
		</script>
	</body>
</html>
